# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Telegram (alerts AND remote commands: /status /pause /resume /stop /mode /otp) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WhatsApp via Evolution API (outbound alerts only) ---
# Leave all four empty to disable the WhatsApp channel.
# EVOLUTION_INSTANCE is the identifier the send route accepts: /message/sendText/<instance>
EVOLUTION_BASE_URL=
EVOLUTION_INSTANCE=
EVOLUTION_APIKEY=
# Destination in E.164 digits, no "+" and no spaces, e.g. 919876543210
EVOLUTION_TO_NUMBER=

# --- Optional external dead-man switch (e.g. Healthchecks.io ping URL) ---
# Empty = no ping attempted.
HEALTHCHECK_URL=
